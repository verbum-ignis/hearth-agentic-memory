{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateBoundedHearthRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/hearth-*",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::<ACCOUNT_ID>:policy/hearth-runtime-boundary"
        }
      }
    },
    {
      "Sid": "ManageOnlyHearthRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:UpdateRoleDescription"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/hearth-*"
    },
    {
      "Sid": "KeepRuntimeBoundaryAttached",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/hearth-*",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::<ACCOUNT_ID>:policy/hearth-runtime-boundary"
        }
      }
    },
    {
      "Sid": "PassOnlyHearthRolesToRuntimeServices",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/hearth-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "apprunner.amazonaws.com",
            "ecs-tasks.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CreateAppRunnerServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/apprunner.amazonaws.com/AWSServiceRoleForAppRunner",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "apprunner.amazonaws.com"
        }
      }
    }
  ]
}

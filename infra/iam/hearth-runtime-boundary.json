{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockEmbeddingRuntime",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-2::foundation-model/amazon.titan-embed-text-v2:0"
      ]
    },
    {
      "Sid": "ReadHearthSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:us-east-2:<ACCOUNT_ID>:secret:hearth-*"
    },
    {
      "Sid": "DecryptHearthSecretsThroughSecretsManager",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.us-east-2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PullHearthImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:us-east-2:<ACCOUNT_ID>:repository/hearth-*"
    },
    {
      "Sid": "GetEcrAuthorizationToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "WriteHearthLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:DescribeLogStreams",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-east-2:<ACCOUNT_ID>:log-group:/aws/apprunner/hearth-*",
        "arn:aws:logs:us-east-2:<ACCOUNT_ID>:log-group:/aws/apprunner/hearth-*:*",
        "arn:aws:logs:us-east-2:<ACCOUNT_ID>:log-group:/ecs/hearth-*",
        "arn:aws:logs:us-east-2:<ACCOUNT_ID>:log-group:/ecs/hearth-*:*"
      ]
    }
  ]
}
